# Purpose: Example environment file for n8n + Postgres + Redis queue mode setup (DO NOT put secrets in git)
# Created/Updated: 2025-01-27
# Agent: BACKEND_AGENT

# ---- n8n runtime ----
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Required: keep stable across restarts/restores or encrypted credentials will break.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Optional: basic auth for UI (recommended if exposed)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Metrics / diagnostics
N8N_METRICS=true
N8N_DIAGNOSTICS_ENABLED=false

# ---- Postgres (used by postgres service + injected into n8n via compose) ----
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# ---- Redis Configuration ----
# Redis password (leave empty for no password, not recommended for production)
REDIS_PASSWORD=

# Optional: Redis memory limit (override redis.conf maxmemory)
# REDIS_MAXMEMORY=256mb

# ---- Queue Mode Configuration ----
# These are set in docker-compose.yaml but can be overridden here
# EXECUTIONS_MODE=queue
# QUEUE_BULL_REDIS_HOST=redis
# QUEUE_BULL_REDIS_PORT=6379
# QUEUE_BULL_REDIS_PASSWORD=${REDIS_PASSWORD:-}
# QUEUE_BULL_REDIS_DB=0
# QUEUE_BULL_REDIS_CONNECTION_TIMEOUT=10000

