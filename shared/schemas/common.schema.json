{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automation-hub.example.com/schemas/v1/common.schema.json",
  "title": "Common Types Schema v1",
  "description": "Reusable type definitions for Automation Hub schemas (UUIDs, timestamps, correlation IDs, and error codes).",
  "definitions": {
    "uuid": {
      "type": "string",
      "description": "UUID (lowercase hex) string. UUID v4 recommended.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "iso_datetime": {
      "type": "string",
      "description": "ISO 8601 date-time string.",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "description": "Correlation ID used for tracing across workflows and systems.",
      "minLength": 1,
      "maxLength": 200
    },
    "error_code": {
      "type": "string",
      "description": "Stable machine-readable error code (snake_case).",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 1,
      "maxLength": 64
    },
    "status_string": {
      "type": "string",
      "description": "Stable status string identifier.",
      "minLength": 1,
      "maxLength": 50
    }
  }
}


