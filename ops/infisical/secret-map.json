{
  "_metadata": {
    "purpose": "Map secrets (Infisical/dotenv-vault) to n8n docker env vars",
    "created": "2025-12-17",
    "author": "GPT-5.2"
  },
  "version": 1,
  "defaultTopology": "postgres",
  "variables": {
    "N8N_HOST": {
      "infisicalKey": "N8N_HOST",
      "required": true,
      "description": "Hostname for n8n (used for URLs + webhook composition)"
    },
    "N8N_PROTOCOL": {
      "infisicalKey": "N8N_PROTOCOL",
      "required": true,
      "description": "http|https"
    },
    "WEBHOOK_URL": {
      "infisicalKey": "WEBHOOK_URL",
      "required": true,
      "description": "Public base URL used by n8n to generate webhook URLs"
    },
    "N8N_ENCRYPTION_KEY": {
      "infisicalKey": "N8N_ENCRYPTION_KEY",
      "required": true,
      "description": "Stable encryption key for n8n credentials"
    },
    "N8N_BASIC_AUTH_ACTIVE": {
      "infisicalKey": "N8N_BASIC_AUTH_ACTIVE",
      "default": "false",
      "required": false,
      "description": "Enable basic auth for the UI"
    },
    "N8N_BASIC_AUTH_USER": {
      "infisicalKey": "N8N_BASIC_AUTH_USER",
      "requiredIf": {
        "var": "N8N_BASIC_AUTH_ACTIVE",
        "equals": "true"
      },
      "description": "Basic auth username (required if basic auth enabled)"
    },
    "N8N_BASIC_AUTH_PASSWORD": {
      "infisicalKey": "N8N_BASIC_AUTH_PASSWORD",
      "requiredIf": {
        "var": "N8N_BASIC_AUTH_ACTIVE",
        "equals": "true"
      },
      "description": "Basic auth password (required if basic auth enabled)"
    },
    "N8N_METRICS": {
      "infisicalKey": "N8N_METRICS",
      "default": "true",
      "required": false,
      "description": "Enable Prometheus metrics endpoint"
    },
    "N8N_DIAGNOSTICS_ENABLED": {
      "infisicalKey": "N8N_DIAGNOSTICS_ENABLED",
      "default": "false",
      "required": false,
      "description": "Disable diagnostics in production"
    },
    "N8N_BIND_ADDR": {
      "infisicalKey": "N8N_BIND_ADDR",
      "default": "127.0.0.1",
      "required": false,
      "description": "Bind address for docker port mapping"
    },
    "N8N_HOST_PORT": {
      "infisicalKey": "N8N_HOST_PORT",
      "default": "5678",
      "required": false,
      "description": "Host port for docker port mapping"
    },
    "POSTGRES_DB": {
      "infisicalKey": "POSTGRES_DB",
      "default": "n8n",
      "requiredForTopologies": ["postgres"],
      "description": "Postgres database name"
    },
    "POSTGRES_USER": {
      "infisicalKey": "POSTGRES_USER",
      "default": "n8n",
      "requiredForTopologies": ["postgres"],
      "description": "Postgres username"
    },
    "POSTGRES_PASSWORD": {
      "infisicalKey": "POSTGRES_PASSWORD",
      "requiredForTopologies": ["postgres"],
      "description": "Postgres password"
    }
  }
}

