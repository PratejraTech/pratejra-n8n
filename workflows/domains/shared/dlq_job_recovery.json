{
  "name": "DLQ Job Recovery",
  "nodes": [
    {
      "parameters": {},
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "dlq-recovery"
    },
    {
      "parameters": {
        "jsCode": "// Get DLQ jobs from Redis\n// This would call the DLQ manager script or Redis directly\nconst jobIds = $input.item.json.job_ids || [];\nreturn jobIds.map(id => ({ json: { job_id: id } }));"
      },
      "id": "get-dlq-jobs",
      "name": "Get DLQ Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.workflow_name }}",
              "operation": "contains",
              "value2": "={{ $('Filter').item.json.filter_workflow }}"
            }
          ]
        }
      },
      "id": "filter-jobs",
      "name": "Filter Jobs",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://dlq-manager:8080/replay",
        "bodyParameters": {
          "parameters": [
            {
              "name": "job_id",
              "value": "={{ $json.job_id }}"
            }
          ]
        }
      },
      "id": "replay-job",
      "name": "Replay Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, replayed_jobs: $input.all().length } }}"
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1050, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Get DLQ Jobs", "type": "main", "index": 0 }]]
    },
    "Get DLQ Jobs": {
      "main": [[{ "node": "Filter Jobs", "type": "main", "index": 0 }]]
    },
    "Filter Jobs": {
      "main": [[{ "node": "Replay Job", "type": "main", "index": 0 }]]
    },
    "Replay Job": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0,
  "updatedAt": "2025-01-27T00:00:00.000Z",
  "versionId": "1"
}

